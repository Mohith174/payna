# The engine reads the repo-root .env by default; these are the vars it uses.
# (Same Neo4j / Postgres / LLM settings as apps/server.)

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=payna-dev-password
DATABASE_URL=postgres://payna:payna@localhost:55432/payna

# OpenAI-compatible LLM endpoint (NVIDIA NIM by default).
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b

# Set true to use the deterministic local extractor instead of the LLM.
MOCK_EXTRACTION=false

# Port the FastAPI engine listens on.
ENGINE_PORT=4100

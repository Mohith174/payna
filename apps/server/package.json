{
  "name": "@payna/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../../.env dist/index.js",
    "migrate": "tsx --env-file=../../.env src/db/migrate.ts",
    "seed": "tsx --env-file=../../.env src/graph/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@payna/shared": "*",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "neo4j-driver": "^5.24.0",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
